{
  "configById": {
    "Image!cam": {
      "cameraTopic": "/camera/image",
      "annotations": { "/camera/annotations": { "visible": true } },
      "synchronize": false
    },
    "3D!scene": {
      "followTf": "ego",
      "followMode": "follow-position",
      "topics": {
        "/lidar": { "visible": true, "colorField": "z", "colorMode": "colormap", "colorMap": "turbo", "pointSize": 2 },
        "/radar": { "visible": true, "colorMode": "flat", "flatColor": "#ff3b3b", "pointSize": 10 },
        "/track": { "visible": true }
      },
      "layers": {
        "grid": { "layerId": "foxglove.Grid", "visible": true, "size": 200, "divisions": 40 }
      },
      "cameraState": { "distance": 60, "perspective": true, "thetaOffset": 0.5, "phi": 0.85 }
    },
    "Plot!speed": {
      "title": "Fused speed estimate (m/s)",
      "paths": [{ "value": "/state.speed", "label": "speed", "enabled": true }],
      "xAxisVal": "timestamp"
    }
  },
  "layout": {
    "first": {
      "first": "Image!cam",
      "second": "3D!scene",
      "direction": "row",
      "splitPercentage": 42
    },
    "second": "Plot!speed",
    "direction": "column",
    "splitPercentage": 72
  }
}
